{
  "agentspec_version": "26.1.0",
  "component_type": "Flow",
  "id": "blog-idea-generator-agent-flow",
  "name": "Blog Idea Generator Agent",
  "description": "Stateless leaf agent that takes a blog brief plus optional context (audience, count, tone, existing ideas, reference content) and returns count blog post ideas with title + summary + 3-7 outline points each. Single LLM round-trip; no MCP primitives; no HITL; no web_search. Returns strict JSON {ideas:[{title,summary,outline}], notes}.",
  "metadata": {
    "cinatra": {
      "type": "flow",
      "packageName": "@cinatra-ai/blog-idea-generator-agent",
      "hitlScreens": [
        "@cinatra-ai/context-selection-agent:context-selector"
      ],
      "llm": {
        "preferredProvider": "openai",
        "preferredModel": "gpt-5.5"
      },
      "contextSlots": [
        {
          "slotId": "ideaContext",
          "acceptedArtifactExtensions": [
            "@cinatra-ai/brand-voice-artifact"
          ],
          "selectionMode": "interactive",
          "resolutionMode": "accumulate",
          "minItems": 0,
          "maxItems": 5
        }
      ],
      "produces": [
        {
          "extension": "@cinatra-ai/blog-idea-artifact"
        }
      ]
    }
  },
  "inputs": [
    {
      "title": "brief",
      "type": "string"
    },
    {
      "title": "audience",
      "type": "string",
      "default": ""
    },
    {
      "title": "count",
      "type": "integer",
      "default": 5
    },
    {
      "title": "tone",
      "type": "string",
      "default": ""
    },
    {
      "title": "existingIdeasContext",
      "type": "array",
      "json_schema": {
        "items": {
          "type": "string"
        }
      },
      "default": []
    },
    {
      "title": "referenceContent",
      "type": "string",
      "default": ""
    },
    {
      "title": "cinatra_run_id",
      "type": "string",
      "default": ""
    },
    {
      "title": "ideaContextParentPackageName",
      "type": "string",
      "default": "@cinatra-ai/blog-idea-generator-agent"
    },
    {
      "title": "ideaContextSlotId",
      "type": "string",
      "default": "ideaContext"
    },
    {
      "title": "projectId",
      "type": "string",
      "default": ""
    }
  ],
  "outputs": [
    {
      "title": "ideas",
      "type": "array",
      "json_schema": {
        "items": {
          "type": "object"
        }
      }
    },
    {
      "title": "notes",
      "type": "string"
    }
