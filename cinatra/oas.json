            }
          }
        },
        {
          "title": "referenceContent",
          "type": "string"
        },
        {
          "title": "agent_run_id",
          "type": "string"
        },
        {
          "title": "contextSlotBindings",
          "type": "array",
          "json_schema": {
            "items": {
              "type": "object",
              "properties": {
                "artifactId": {
                  "type": "string"
                },
                "representationRevisionId": {
                  "type": "string"
                },
                "semanticAssertionId": {
                  "type": "string"
                },
                "extension": {
                  "type": "string"
                },
                "sourceScope": {
                  "type": "string"
                },
                "ownerId": {
                  "type": "string"
                }
              }
            }
          }
        }
      ],
      "outputs": [
