              }
            }
          }
        }
      ],
      "outputs": [
        {
          "title": "ideas",
          "type": "array",
          "json_schema": {
            "items": {
              "type": "string"
            }
          }
        },
        {
          "title": "notes",
          "type": "string"
        }
      ],
      "metadata": {
        "cinatra": {
          "riskClass": "read_only",
          "requiresApproval": false,
          "packageName": "@cinatra-ai/blog-idea-generator-agent",
          "description": "Single ApiNode -> /api/llm-bridge. The agent's operating instructions are inline in data.system (no embedded skill bundle). Single bridge invocation; this node declares an empty toolbox list in data.toolbox_ids, so the host attaches no toolbox to this turn and the model answers with the bare two-key JSON envelope. No HITL gates; the LLM returns the JSON envelope and the run completes. The host run-completion materializer then files ONE @cinatra-ai/blog-idea-artifact per member of ideas through the declarative fan-out EndNode binding, each titled from that member's own first line, not a tool call the LLM makes."
        }
      }
    },
