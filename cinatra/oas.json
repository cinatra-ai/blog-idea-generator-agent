          "title": "ideas",
          "type": "array",
          "json_schema": {
            "items": {
              "type": "object"
            }
          }
        },
        {
          "title": "notes",
          "type": "string"
        }
      ],
      "metadata": {
        "cinatra": {
          "riskClass": "write_safe",
          "requiresApproval": false,
          "packageName": "@cinatra-ai/blog-idea-generator-agent",
          "description": "Single ApiNode \u2192 /api/llm-bridge. Bridge auto-discovers SKILL.md from agents/cinatra/blog-idea-generator-agent/skills/blog-idea-generator-agent/SKILL.md (via agent_id). metadata.cinatra.toolboxes is INTENTIONALLY OMITTED so default toolbox injection runs; the SKILL.md instructs the LLM NOT to call any MCP primitive \u2014 ideas are generated purely from inline inputs. No HITL gates; the LLM returns the JSON envelope and the run completes."
        }
      }
