      "data": {
        "agent_id": "blog-idea-generator-agent",
        "system": "You are a stateless blog-idea-generator agent. Follow the SKILL.md step-by-step. Return a single JSON object {ideas:[{title, summary, outline:[...]}], notes} \u2014 nothing else; no markdown wrapping; no prose preface.",
        "user": "Generate count distinct blog post ideas for the brief below. Each idea needs a title (\u226480 chars), a 1-2 sentence summary, and 3-7 outline points covering the post arc. Respect tone if provided. Avoid topics in existingIdeasContext.\nInputs:\n- brief: {{ brief }}\n- audience: {{ audience }}\n- count: {{ count }}\n- tone: {{ tone }}\n- existingIdeasContext: {{ existingIdeasContext }}\n- referenceContent: {{ referenceContent }}\n- contextSlotBindings: {{ contextSlotBindings }}",
        "agent_run_id": "{{ agent_run_id }}",
        "cinatra_llm": {
          "preferredProvider": "openai",
          "preferredModel": "gpt-5.5"
        }
      },
      "inputs": [
        {
          "title": "brief",
          "type": "string"
